{
  "name": "opencode-throughput",
  "version": "1.2.0",
  "description": "Real-time LLM performance monitoring plugin for OpenCode. Tracks TTFT, TPS, latency, token usage and cost per model with toast notifications and JSONL logging.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./plugins/*": "./src/plugins/*",
    "./tui": {
      "import": "./dist/tui.js",
      "types": "./src/tui.tsx"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "build:server": "bun build src/index.ts --outdir dist --target node",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "llm",
    "benchmark",
    "throughput",
    "latency",
    "ttft",
    "tps",
    "monitoring",
    "performance"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Howardzhangdqs/opencode-throughput.git"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0",
    "@opentui/core": "^0.4.0",
    "@opentui/solid": "^0.4.0",
    "solid-js": "^1.9.11"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.2.27",
    "@opentui/core": "^0.4.0",
    "@opentui/solid": "^0.4.0",
    "@types/node": "^25.5.0",
    "solid-js": "1.9.12",
    "typescript": "^5.7.0"
  }
}
